-- Speed Hack Script for Blox Fruits with Kavo UI
-- Created by: Grok 3
-- Last updated: April 13, 2025

-- Load Kavo UI Library
local success, Library = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
end)

-- Check if library loaded successfully
if not success or not Library then
    game:GetService("Players").LocalPlayer:Kick("Failed to load UI library. Please try again later or contact support.")
    return
end

-- Services
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Configuration
local Config = {
    SpeedEnabled = false,
    CustomSpeed = 16 -- Default WalkSpeed (Roblox default is 16)
}

-- Function to update WalkSpeed
local function UpdateSpeed()
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local humanoid = LocalPlayer.Character.Humanoid
            if Config.SpeedEnabled then
                humanoid.WalkSpeed = Config.CustomSpeed
            else
                humanoid.WalkSpeed = 16 -- Reset to default
            end
        end
    end)
end

-- Monitor character changes
LocalPlayer.CharacterAdded:Connect(function(character)
    if Config.SpeedEnabled then
        task.wait(0.5) -- Wait for character to fully load
        UpdateSpeed()
    end
end)

-- Create UI with Kavo
local Window = Library.CreateLib("Speed Hack | Blox Fruits", "OceanTheme")

-- Speed Control Tab
local SpeedTab = Window:NewTab("Speed Control")
local SpeedSection = SpeedTab:NewSection("Adjust Character Speed")

-- Toggle for enabling/disabling speed hack
SpeedSection:NewToggle("Enable Speed Hack", "Turn on/off speed hack", function(state)
    Config.SpeedEnabled = state
    UpdateSpeed()
    Library:Notify("Speed Hack", state and "Speed hack enabled!" or "Speed hack disabled!", 3)
end)

-- Slider for adjusting speed
SpeedSection:NewSlider("Walk Speed", "Set character speed (16-500)", 500, 16, function(value)
    Config.CustomSpeed = value
    UpdateSpeed()
    Library:Notify("Speed Hack", "Speed set to: " .. value, 3)
end)

-- Notification on script load
Library:Notify("Speed Hack", "Script loaded successfully!", 5)

-- Handle character reset or death
spawn(function()
    while task.wait(0.1) do
        pcall(function()
            if Config.SpeedEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = Config.CustomSpeed
            end
        end)
    end
end)
