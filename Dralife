local Config = {
    AutoFarm = false,
    Auto_Bone2 = false,
    Auto_Random_Bone2 = false,
    AutoSkill = false,
    SelectWeapon = "Combat",
    IslandESP = false,
    PlayerESP = false
}

local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local game = game
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

-- World Detection
local World1, World2, World3 = false, false, false
if game.PlaceId == 2753915549 then
    World1 = true
elseif game.PlaceId == 4442272183 then
    World2 = true
elseif game.PlaceId == 7449423635 then
    World3 = true
else
    LocalPlayer:Kick("Unsupported PlaceId, please wait...")
end

-- Utility Functions
local function AutoHaki()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Buso") then
        ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso")
    end
end

local function EquipWeapon(weaponName)
    local tool = LocalPlayer.Backpack:FindFirstChild(weaponName)
    if tool then
        LocalPlayer.Character.Humanoid:EquipTool(tool)
    end
end

local function topos(targetCFrame)
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            if (hrp.Position - targetCFrame.Position).Magnitude > 5 then
                hrp.CFrame = targetCFrame
            end
        end
    end)
end

-- Check Quest
local function CheckQuest()
    local MyLevel = LocalPlayer.Data.Level.Value
    if World1 then
        if MyLevel <= 9 then
            return {
                Mon = "Bandit",
                LevelQuest = 1,
                NameQuest = "BanditQuest1",
                NameMon = "Bandit",
                CFrameQuest = CFrame.new(1059.37195, 15.4495068, 1550.4231),
                CFrameMon = CFrame.new(1045.962646484375, 27.00250816345215, 1560.8203125)
            }
        elseif MyLevel <= 14 then
            return {
                Mon = "Monkey",
                LevelQuest = 1,
                NameQuest = "JungleQuest",
                NameMon = "Monkey",
                CFrameQuest = CFrame.new(-1598.08911, 35.5501175, 153.377838),
                CFrameMon = CFrame.new(-1448.51806640625, 67.85301208496094, 11.46579647064209)
            }
        end
    elseif World2 then
        if MyLevel <= 724 then
            return {
                Mon = "Raider",
                LevelQuest = 1,
                NameQuest = "Area1Quest",
                NameMon = "Raider",
                CFrameQuest = CFrame.new(-429.543518, 71.7699966, 1836.18188),
                CFrameMon = CFrame.new(-728.3267211914062, 52.779319763183594, 2345.7705078125)
            }
        end
    elseif World3 then
        if MyLevel <= 1524 then
            return {
                Mon = "Pirate Millionaire",
                LevelQuest = 1,
                NameQuest = "PiratePortQuest",
                NameMon = "Pirate Millionaire",
                CFrameQuest = CFrame.new(-290.074677, 42.9034653, 5581.58984),
                CFrameMon = CFrame.new(-245.9963836669922, 47.30615234375, 5584.1005859375)
            }
        end
    end
    return nil
end

-- AutoFarm
spawn(function()
    while task.wait(0.1) do
        if Config.AutoFarm then
            pcall(function()
                local questData = CheckQuest()
                if questData and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local monName = questData.Mon
                    if Workspace.Enemies:FindFirstChild(monName) then
                        for _, v in pairs(Workspace.Enemies:GetChildren()) do
                            if v.Name == monName and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                                repeat task.wait()
                                    if v.Parent and v:FindFirstChild("Humanoid") then
                                        AutoHaki()
                                        EquipWeapon(Config.SelectWeapon)
                                        v.HumanoidRootPart.CanCollide = false
                                        v.Humanoid.WalkSpeed = 0
                                        topos(v.HumanoidRootPart.CFrame * CFrame.new(0, 20, 0))
                                        VirtualUser:CaptureController()
                                        VirtualUser:Button1Down(Vector2.new(1280, 672))
                                    end
                                until not Config.AutoFarm or not v.Parent or not v:FindFirstChild("Humanoid") or v.Humanoid.Health <= 0
                            end
                        end
                    else
                        topos(questData.CFrameMon)
                    end
                end
            end)
        end
    end
end)

-- Auto Bone Farm
spawn(function()
    while task.wait(0.1) do
        if Config.Auto_Bone2 and World3 then
            pcall(function()
                local boneFrame = CFrame.new(-9508.5673828125, 142.1398468017578, 5737.3603515625)
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    topos(boneFrame)
                    for _, v in pairs(Workspace.Enemies:GetChildren()) do
                        if v.Name == "Reborn Skeleton" or v.Name == "Living Zombie" or v.Name == "Demonic Soul" or v.Name == "Posessed Mummy" then
                            if v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                                repeat task.wait()
                                    if v.Parent and v:FindFirstChild("Humanoid") then
                                        AutoHaki()
                                        EquipWeapon(Config.SelectWeapon)
                                        v.HumanoidRootPart.CanCollide = false
                                        v.Humanoid.WalkSpeed = 0
                                        topos(v.HumanoidRootPart.CFrame * CFrame.new(0, 20, 0))
                                        VirtualUser:CaptureController()
                                        VirtualUser:Button1Down(Vector2.new(1280, 672))
                                    end
                                until not Config.Auto_Bone2 or not v.Parent or not v:FindFirstChild("Humanoid") or v.Humanoid.Health <= 0
                            end
                        end
                    end
                end
            end)
        end
    end
end)

